    "selectedTextBackground": "#3D2A4A",
    "selectedTextBorder": "#FF8A9E",
    "textSelected": "#FFFFFF",
    "selectionInsert": "#FF8A9E",
    "selectionHandle": "#FF8A9E",
    "underline": "#7A5A7A",
    "scrollBarThumb": "#3D2A4A",
    "scrollBarThumbPressed": "#FF8A9E",
    "scrollBarTrack": "#1E1428",
