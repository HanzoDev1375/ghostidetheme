    "scrim": "#000000",

    "inverseSurface": "#E6D4C0",
    "inverseOnSurface": "#2A1A0E",
    "inversePrimary": "#8A4A1A",

    "primaryFixed": "#F0D4B0",
    "onPrimaryFixed": "#2A1A0E",
