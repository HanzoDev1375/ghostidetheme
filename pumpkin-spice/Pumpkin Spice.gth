    "selectedTextBorder": "#D47A2A",
    "textSelected": "#FFFFFF",
    "selectionInsert": "#D47A2A",
    "selectionHandle": "#D47A2A",
    "underline": "#8A7A5A",
    "scrollBarThumb": "#4A3A2A",
