    "onTertiaryFixedVariant": "#2A1A0E",

    "surfaceDim": "#2A1A0E",
    "surfaceBright": "#5A4A3A",
    "surfaceContainerLowest": "#1A120A",
    "surfaceContainerLow": "#3D2A1A",
    "surfaceContainer": "#45301E",
