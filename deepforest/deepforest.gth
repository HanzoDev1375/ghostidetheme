{
  "activity": {
    "background": "#0F1A12",
    "statusBar": "#0F1A12",
    "navigationBar": "#0F1A12"
  },

  "editor": {
    "wholeBackground": "#0F1A12",
    "lineDivider": "#1E3326",
    "lineNumber": "#5A7A66",
    "lineNumberBackground": "#0F1A12",
    "lineNumberPanel": "#0F1A12",
    "lineNumberPanelText": "#5A7A66",
    "lineNumberCurrent": "#7DBD8A",
    "currentLine": "#16261C",
    "currentRowBorder": "#7DBD8A",
    "textNormal": "#D4E8D0",
    "selectedTextBackground": "#2A4A36",
    "selectedTextBorder": "#7DBD8A",
    "textSelected": "#FFFFFF",
    "selectionInsert": "#7DBD8A",
    "selectionHandle": "#7DBD8A",
    "underline": "#7A9A7A",
    "scrollBarThumb": "#2A4A36",
    "scrollBarThumbPressed": "#7DBD8A",
    "scrollBarTrack": "#0F1A12",
    "blockLine": "#1E3326",
    "blockLineCurrent": "#7DBD8A",
    "sideBlockLine": "#1E3326",
    "hardWrapMarker": "#1E3326",
    "strikeThrough": "#00000000",

    "keyword": "#C792EA",
    "comment": "#546E7A",
    "operator": "#89DDFF",
    "literal": "#F78C6C",
    "identifierVar": "#EEFFFF",
    "identifierName": "#82AAFF",
    "functionName": "#FFCB6B",
    "annotation": "#C3E88D",
    "htmlTag": "#FF5370",
    "attributeName": "#F78C6C",
    "attributeValue": "#82AAFF",
    "nonPrintableChar": "#2A4A36",
    "colornextdot": "#C792EA",
    "colornextbrak": "#89DDFF",
    "colornextchar": "#F78C6C",
    "coloruppercase": "#82AAFF",
    "colornextless": "#C3E88D",

    "matchedTextBackground": "#2A4A36",
    "matchedTextBorder": "#7DBD8A",
    "highlightedDelimitersBackground": "#16261C",
    "highlightedDelimitersUnderline": "#7DBD8A",
    "highlightedDelimitersForeground": "#D4E8D0",
    "highlightedDelimitersBorder": "#7DBD8A",
    "textHighlightBackground": "#2A4A36",
    "textHighlightBorder": "#7DBD8A",
    "textHighlightStrongBackground": "#16261C",
    "textHighlightStrongBorder": "#C792EA",
    "staticSpanBackground": "#0F1A12",
    "staticSpanForeground": "#D4E8D0",

    "problemError": "#FF5370",
    "problemWarning": "#FFCB6B",
    "problemTypo": "#82AAFF",

    "signatureBackground": "#0F1A12",
    "signatureBorder": "#1E3326",
    "signatureTextNormal": "#D4E8D0",
    "signatureTextHighlightedParameter": "#F78C6C",
    "hoverBackground": "#16261C",
    "hoverBorder": "#7DBD8A",
    "hoverTextNormal": "#D4E8D0",
    "hoverTextHighlighted": "#82AAFF",

    "diagnosticTooltipBackground": "#16261C",
    "diagnosticTooltipBriefMsg": "#D4E8D0",
    "diagnosticTooltipDetailedMsg": "#5A7A66",
    "diagnosticTooltipAction": "#82AAFF",
    "textActionWindowBackground": "#0F1A12",
    "textActionWindowIconColor": "#D4E8D0",

    "textInlayHintBackground": "#16261C",
    "textInlayHintForeground": "#546E7A",
    "snippetBackgroundEditing": "#16261C",
    "snippetBackgroundRelated": "#2A4A36",
    "snippetBackgroundInactive": "#0F1A12",
    "functionCharBackgroundStroke": "#1E3326",

    "minimapBackground": "#A00F1A12",
    "minimapViewport": "#307DBD8A",
    "minimapViewportBorder": "#B07DBD8A",

    "bracketlevelmatch1": "#7DBD8A",
    "bracketlevelmatch2": "#C792EA",
    "bracketlevelmatch3": "#89DDFF",
    "bracketlevelmatch4": "#F78C6C",
    "bracketlevelmatch5": "#FFCB6B",
    "bracketlevelmatch6": "#C3E88D",

    "stickyScrollDivider": "#1E3326",

    "completionWndBackground": "#0F1A12",
    "completionWndCorner": "#0F1A12",
    "completionWndTextPrimary": "#D4E8D0",
    "completionWndTextSecondary": "#5A7A66",
    "completionWndItemCurrent": "#16261C",
    "completionWndTextMatched": "#82AAFF"
  },

  "widget": {
    "text": "@editor.textNormal",
    "hint": "#5A7A66",
    "accent": "@material3.primary",
    "background": "@activity.background",
    "surface": "#16261C",
    "stroke": "#1E3326",
    "fabBackground": "@widget.accent",
    "fabIcon": "#0F1A12",
    "tabSelected": "@widget.accent",
    "tabUnselected": "#5A7A66",
    "imageTint": "@widget.text",
    "menubackground": "@widget.background",
    "menutextcolor": "@widget.text",
    "selectedmenucolor": "@widget.surface",
    "imagepath": "",
    "blursize": 6
  },

  "material3": {
    "primary": "#7DBD8A",
    "surfaceTint": "#7DBD8A",
    "onPrimary": "#0F1A12",
    "primaryContainer": "#2A6A3A",
    "onPrimaryContainer": "#FFFFFF",

    "secondary": "#5A7A66",
    "onSecondary": "#0F1A12",
    "secondaryContainer": "#1E3326",
    "onSecondaryContainer": "#D4E8D0",

    "tertiary": "#A3C9A8",
    "onTertiary": "#0F1A12",
    "tertiaryContainer": "#3A5A44",
    "onTertiaryContainer": "#FFFFFF",

    "error": "#FF5370",
    "onError": "#0F1A12",
    "errorContainer": "#8A3A4A",
    "onErrorContainer": "#FFFFFF",

    "background": "@activity.background",
    "onBackground": "@editor.textNormal",
    "surface": "@widget.background",
    "onSurface": "@widget.text",
    "surfaceVariant": "#16261C",
    "onSurfaceVariant": "#5A7A66",

    "outline": "#2A4A36",
    "outlineVariant": "#1E3326",
    "shadow": "#000000",
    "scrim": "#000000",

    "inverseSurface": "#D4E8D0",
    "inverseOnSurface": "#0F1A12",
    "inversePrimary": "#2A6A3A",

    "primaryFixed": "#D4E8D0",
    "onPrimaryFixed": "#0F1A12",
    "primaryFixedDim": "#7DBD8A",
    "onPrimaryFixedVariant": "#0F1A12",

    "secondaryFixed": "#D4E8D0",
    "onSecondaryFixed": "#0F1A12",
    "secondaryFixedDim": "#5A7A66",
    "onSecondaryFixedVariant": "#0F1A12",

    "tertiaryFixed": "#D4E8D0",
    "onTertiaryFixed": "#0F1A12",
    "tertiaryFixedDim": "#A3C9A8",
    "onTertiaryFixedVariant": "#0F1A12",

    "surfaceDim": "#0F1A12",
    "surfaceBright": "#2A3A2E",
    "surfaceContainerLowest": "#0A120E",
    "surfaceContainerLow": "#16261C",
    "surfaceContainer": "#1C2E22",
    "surfaceContainerHigh": "#223628",
    "surfaceContainerHighest": "#2A3A2E"
  }
}