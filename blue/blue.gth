{
  "activity": {
    "background": "#0D1117",
    "statusBar": "#0D1117",
    "navigationBar": "#0D1117"
  },

  "editor": {
    "wholeBackground": "#0D1117",
    "lineDivider": "#21262D",
    "lineNumber": "#8B949E",
    "lineNumberBackground": "#0D1117",
    "lineNumberPanel": "#0D1117",
    "lineNumberPanelText": "#8B949E",
    "lineNumberCurrent": "#58A6FF",
    "currentLine": "#161B22",
    "currentRowBorder": "#58A6FF",
    "textNormal": "#E6EDF3",
    "selectedTextBackground": "#388BFD",
    "selectedTextBorder": "#58A6FF",
    "textSelected": "#FFFFFF",
    "selectionInsert": "#58A6FF",
    "selectionHandle": "#58A6FF",
    "underline": "#8B949E",
    "scrollBarThumb": "#30363D",
    "scrollBarThumbPressed": "#58A6FF",
    "scrollBarTrack": "#0D1117",
    "blockLine": "#21262D",
    "blockLineCurrent": "#58A6FF",
    "sideBlockLine": "#21262D",
    "hardWrapMarker": "#21262D",
    "strikeThrough": "#00000000",

    "keyword": "#FF7B72",
    "comment": "#8B949E",
    "operator": "#E6EDF3",
    "literal": "#A5D6FF",
    "identifierVar": "#E6EDF3",
    "identifierName": "#E6EDF3",
    "functionName": "#D2A8FF",
    "annotation": "#D2A8FF",
    "htmlTag": "#FF7B72",
    "attributeName": "#A5D6FF",
    "attributeValue": "#A5D6FF",
    "nonPrintableChar": "#30363D",
    "colornextdot": "#D2A8FF",
    "colornextbrak": "#58A6FF",
    "colornextchar": "#A5D6FF",
    "coloruppercase": "#D2A8FF",
    "colornextless": "#A5D6FF",

    "matchedTextBackground": "#30363D",
    "matchedTextBorder": "#58A6FF",
    "highlightedDelimitersBackground": "#161B22",
    "highlightedDelimitersUnderline": "#58A6FF",
    "highlightedDelimitersForeground": "#E6EDF3",
    "highlightedDelimitersBorder": "#58A6FF",
    "textHighlightBackground": "#30363D",
    "textHighlightBorder": "#58A6FF",
    "textHighlightStrongBackground": "#161B22",
    "textHighlightStrongBorder": "#FF7B72",
    "staticSpanBackground": "#0D1117",
    "staticSpanForeground": "#E6EDF3",

    "problemError": "#F85149",
