    "shadow": "#000000",
    "scrim": "#000000",

    "inverseSurface": "#E6EDF3",
    "inverseOnSurface": "#0D1117",
    "inversePrimary": "#1F6FEB",

    "primaryFixed": "#D2D9E6",
    "onPrimaryFixed": "#0D1117",
    "primaryFixedDim": "#58A6FF",
    "onPrimaryFixedVariant": "#0D1117",

    "secondaryFixed": "#D2D9E6",
    "onSecondaryFixed": "#0D1117",
    "secondaryFixedDim": "#8B949E",
    "onSecondaryFixedVariant": "#0D1117",

    "tertiaryFixed": "#E6D2F0",
