    "signatureBackground": "#0D1117",
    "signatureBorder": "#21262D",
    "signatureTextNormal": "#E6EDF3",
    "signatureTextHighlightedParameter": "#A5D6FF",
    "hoverBackground": "#161B22",
    "hoverBorder": "#58A6FF",
    "hoverTextNormal": "#E6EDF3",
    "hoverTextHighlighted": "#58A6FF",

    "diagnosticTooltipBackground": "#161B22",
    "diagnosticTooltipBriefMsg": "#E6EDF3",
    "diagnosticTooltipDetailedMsg": "#8B949E",
    "diagnosticTooltipAction": "#58A6FF",
    "textActionWindowBackground": "#0D1117",
    "textActionWindowIconColor": "#E6EDF3",

    "textInlayHintBackground": "#161B22",
